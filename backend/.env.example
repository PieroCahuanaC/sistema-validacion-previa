# Copiar como backend/.env (no se versiona). Valores del AMBIENTE DE DESARROLLO con datos mock.
AMBIENTE=desarrollo
DATABASE_URL=postgresql+psycopg://svp:svp_dev_local@localhost:5432/svp_dev
CORS_ORIGINS=http://localhost:4321
# Clave para firmar las sesiones (JWT). En desarrollo puede quedar vacía: se genera al iniciar.
# En calidad y producción es obligatoria; genere una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
CLAVE_JWT=
# Clave para cifrar el RUC y el nombre de los proveedores persona natural (AES-256-GCM) y
# para el resumen HMAC del RUC. Obligatoria en calidad y producción (64 caracteres
# hexadecimales). No la cambie después de cargar proveedores: los datos cifrados dejarían
# de poder leerse. Genere una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
CLAVE_CIFRADO=
# Conexiones a la base por proceso (DEF-01 de la Práctica 9). Su suma es también el máximo de
# peticiones que la API atiende a la vez; las demás esperan ESPERA_TURNO_SEGUNDOS y luego
# reciben 503. Con el pooler de Supabase en modo sesión (puerto 5432) el total de clientes es
# 15, compartido con la extracción del MEF; en modo transacción (puerto 6543) no hay ese límite.
BD_POOL_TAMANO=5
BD_POOL_EXTRA=5
ESPERA_TURNO_SEGUNDOS=10
# Modo transacción del pooler: se deduce del puerto 6543; defínalo solo para forzarlo.
# BD_MODO_TRANSACCION=true
