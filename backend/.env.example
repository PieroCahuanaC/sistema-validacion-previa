# Copiar como backend/.env (no se versiona). Valores del AMBIENTE DE DESARROLLO con datos mock.
AMBIENTE=desarrollo
DATABASE_URL=postgresql+psycopg://svp:svp_dev_local@localhost:5432/svp_dev
CORS_ORIGINS=http://localhost:4321
# Clave para firmar las sesiones (JWT). En desarrollo puede quedar vacía: se genera al iniciar.
# En calidad y producción es obligatoria; genere una con:
#   python -c "import secrets; print(secrets.token_hex(32))"
CLAVE_JWT=
